{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const{execSync}=require('child_process'),p=require('path'),h=require('os').homedir();execSync(\\\"node \\\"+p.join(h,'/Users/bilibili/.codex/hooks/security-guard.js'),{stdio:'inherit'})\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"/Users/bilibili/.codex/hooks/run-node-hook.sh\" \"session-start.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"/Users/bilibili/.codex/hooks/run-node-hook.sh\" \"skill-forced-eval.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"/Users/bilibili/.codex/hooks/run-node-hook.sh\" \"stop-summary.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
