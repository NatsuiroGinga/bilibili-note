{
  "description": "禁止运行 Prettier，并在上下文压缩前更新活动计划快照；其他项目执行门禁继续暂停。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/prettier_guard.py\"",
            "timeout": 5,
            "statusMessage": "检查是否调用 Prettier"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/precompact_snapshot.py\"",
            "timeout": 8,
            "statusMessage": "更新活动计划快照"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/update_project_index.py\" --mark-dirty",
            "timeout": 3,
            "async": true,
            "statusMessage": "标记项目索引刷新"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/update_project_index.py\" --refresh-if-dirty --force",
            "timeout": 10,
            "async": true,
            "statusMessage": "刷新项目索引"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "other",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/tools/update_project_index.py\" --refresh-if-dirty --force",
            "timeout": 10,
            "async": true,
            "statusMessage": "刷新项目索引"
          }
        ]
      }
    ]
  }
}
