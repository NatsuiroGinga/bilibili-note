#!/usr/bin/expect -f
# 按精确文件清单压缩拉取制品，避免把无关实验数据带回本机。
set timeout -1
if {$argc != 3} {
    puts stderr "用法：gpu_rsync_pull_files_compressed.exp <服务器根目录> <本机根目录> <本机相对文件清单>"
    exit 2
}
foreach env_name {GPU_SSH_ACTIVE GPU_PWD_ACTIVE} {
    if {![info exists env($env_name)] || $env($env_name) eq ""} {
        puts stderr "缺少必需环境变量：$env_name"
        exit 2
    }
}
set remote_path [lindex $argv 0]
set local_path [lindex $argv 1]
set file_list [lindex $argv 2]
set ssh_command [split $env(GPU_SSH_ACTIVE) " "]
set remote_host [lindex $ssh_command end]
set remote_shell [join [lrange $ssh_command 0 end-1] " "]
spawn rsync -rtvz --partial --files-from=$file_list --progress -e $remote_shell "$remote_host:$remote_path" $local_path
expect {
    -re {(?i)are you sure you want to continue connecting} {
        send -- "yes\r"
        exp_continue
    }
    -re {(?i)password:} {
        send -- "$env(GPU_PWD_ACTIVE)\r"
        exp_continue
    }
    eof {}
}
set wait_result [wait]
exit [lindex $wait_result 3]
