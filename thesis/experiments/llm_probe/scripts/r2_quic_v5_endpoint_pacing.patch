 use std::cmp;
 
 use std::io;
+use std::sync::atomic::{AtomicU64, Ordering};
 
+static R2_QUIC_V5_PACING_SEQUENCE: AtomicU64 = AtomicU64::new(0);
+
+fn r2_quic_v5_pacing_enabled() -> bool {
+    std::env::var_os("R2_QUIC_V5_USERSPACE_PACING").as_deref()
+        == Some(std::ffi::OsStr::new("1"))
+}
+
+fn receipt_time_ns(time: &std::time::Instant) -> u64 {
+    #[cfg(target_os = "linux")]
+    {
+        std_time_to_u64(time)
+    }
+
+    #[cfg(not(target_os = "linux"))]
+    {
+        let _ = time;
+        0
+    }
+}
+
+/// 在 v5 工具隔离环境中兑现 `SendInfo.at`，并输出可机器审计的节奏收据。
+pub fn send_to_userspace_paced(
+    socket: &mio::net::UdpSocket, buf: &[u8], send_info: &quiche::SendInfo,
+    segment_size: usize, endpoint_role: &str, pacing_requested: bool,
+) -> io::Result<usize> {
+    if !r2_quic_v5_pacing_enabled() {
+        return socket.send_to(buf, send_info.to);
+    }
+
+    let before_wait = std::time::Instant::now();
+    if send_info.at > before_wait {
+        std::thread::sleep(send_info.at - before_wait);
+    }
+
+    let mut off = 0;
+    let mut left = buf.len();
+    let mut written = 0;
+    while left > 0 {
+        let packet_bytes = cmp::min(left, segment_size);
+        let actual_at = std::time::Instant::now();
+        let sent = socket.send_to(&buf[off..off + packet_bytes], send_info.to)?;
+        let sequence = R2_QUIC_V5_PACING_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+        let lateness_ns = actual_at
+            .checked_duration_since(send_info.at)
+            .unwrap_or_default()
+            .as_nanos();
+        eprintln!(
+            "R2_QUIC_V5_PACING {{\"schema_version\":\"flow_probe_r2_quic_endpoint_pacing_v5\",\"implementation\":\"quiche\",\"endpoint_role\":\"{}\",\"sequence\":{},\"planned_monotonic_ns\":{},\"actual_monotonic_ns\":{},\"lateness_ns\":{},\"packet_bytes\":{},\"pacing_requested\":{}}}",
+            endpoint_role,
+            sequence,
+            receipt_time_ns(&send_info.at),
+            receipt_time_ns(&actual_at),
+            lateness_ns,
+            sent,
+            pacing_requested,
+        );
+        written += sent;
+        off += packet_bytes;
+        left -= packet_bytes;
+    }
+    Ok(written)
+}
+
+/// 为版本协商和重试等没有 `SendInfo.at` 的控制报文记录即时发送收据。
+pub fn send_to_immediate_receipt(
+    socket: &mio::net::UdpSocket, buf: &[u8], to: std::net::SocketAddr,
+    endpoint_role: &str,
+) -> io::Result<usize> {
+    if !r2_quic_v5_pacing_enabled() {
+        return socket.send_to(buf, to);
+    }
+    let actual_at = std::time::Instant::now();
+    let sent = socket.send_to(buf, to)?;
+    let sequence = R2_QUIC_V5_PACING_SEQUENCE.fetch_add(1, Ordering::Relaxed);
+    let actual_ns = receipt_time_ns(&actual_at);
+    eprintln!(
+        "R2_QUIC_V5_PACING {{\"schema_version\":\"flow_probe_r2_quic_endpoint_pacing_v5\",\"implementation\":\"quiche\",\"endpoint_role\":\"{}\",\"sequence\":{},\"planned_monotonic_ns\":{},\"actual_monotonic_ns\":{},\"lateness_ns\":0,\"packet_bytes\":{},\"pacing_requested\":false}}",
+        endpoint_role, sequence, actual_ns, actual_ns, sent,
+    );
+    Ok(sent)
+}
