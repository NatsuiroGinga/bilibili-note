{
  "claudeMdExcludes": [
    "**/.claude/rules/go-code-review.md",
    "**/.claude/rules/go-error-handling.md"
  ],
  "permissions": {
    "allow": [
      "Bash(cp /Users/bilibili/Downloads/2504.13592v2.pdf /Users/bilibili/personal/note/raw/papers/)",
      "Bash(pdftotext -layout /Users/bilibili/personal/note/raw/papers/2504.13592v2.pdf -)"
    ],
    "deny": [
      "mcp__computer-use"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.Codex/hooks/session_start_env_check.py\" 2>/dev/null || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.Codex/hooks/prettier_guard.py\"",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"$(git rev-parse --show-toplevel)/.Codex/hooks/on_demand_rule_reminder.py\"; [ -f \"$H\" ] || H=\"$(git rev-parse --path-format=absolute --git-common-dir)/../.Codex/hooks/on_demand_rule_reminder.py\"; [ -f \"$H\" ] && python3 \"$H\" || true",
            "timeout": 5000
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.Codex/hooks/precompact_snapshot.py\"",
            "timeout": 8000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.Codex/hooks/skill_routing_reminder.py\""
          }
        ]
      }
    ]
  }
}
